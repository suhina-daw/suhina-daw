# Code that runs with the repository's secrets and app keys needs the repository owner's own
# approval: the workflows, and the scripts the workflows on main run with them. The main ruleset
# requires a code owner's review, so `ready to merge` alone (an approval by suhina-docs-bot) does not
# merge a change here. Everything else follows the usual review and `ready to merge`.
/.github/ @juhamikael
/scripts/ @juhamikael

# The updater installs and runs what it downloads, so where it looks needs the same approval
# (docs/spec/updates.md › Where builds come from). Keep in step with WATCHED in
# scripts/updater_source.py.
/crates/update/ @juhamikael
/crates/ui/src/app/updates.rs @juhamikael
/crates/ui/src/settings/update_settings.rs @juhamikael

# Parity runs without environment secrets; publishing its output is a separate job.
# Leave owners empty so parity changes follow the usual review and `ready to merge`.
/scripts/parity/
