# Raw sample data used as golden test references: never convert line endings.
*.f32 binary
*.syx binary
# Stems test files (crates/media/tests/data).
*.mp4 binary
*.m4a binary
# Device files compared byte for byte with what `to_sd` writes: LF on every platform.
*.sd text eol=lf
# A copy of the app's core theme sheet, compared byte for byte with what the app writes: LF everywhere.
crates/theme-package/src/core.css text eol=lf

# Generated on main after every merge (.github/workflows/docs-generated.yml); collapsed in diffs.
docs/INDEX.md linguist-generated=true
docs/commands.md linguist-generated=true
# The pack's files are shipped byte for byte (`packs/`): nothing converts them.
*.nam -text
*.wav -text
