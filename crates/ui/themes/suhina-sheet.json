    "meter.normal": "#00B050",
    "meter.hot": "#DC9A21",
    "slot.empty": "#C5D3C9",
    "track.mutedBackground": "#E7ECE8",
    "pan.background": "#FFFFFF",
    "pan.centre": "#95AB9C",
    "clip.midiDefault": "#A9D18E",
    "clip.audioDefault": "#9BC2E6",
    "track.1": "#C99070",
    "track.2": "#D8BA64",
    "track.3": "#83A9B4",
    "track.4": "#A699B8",
    "track.5": "#95AA80",
    "track.6": "#C18F9E",
    "track.7": "#879BBE",
    "track.8": "#80ADA1",
    "kind.kick": "#D06E5E",
    "kind.snare": "#73AAC0",
    "kind.clap": "#5EC0B0",
    "kind.closedHat": "#C6AC5E",
    "kind.openHat": "#D08F6E",
