    "browser.text.primary": "#123E24",
    "browser.text.secondary": "#1F5732",
    "browser.text.hint": "#346C46",
    "browser.text.value": "#123E24",
    "text.onColorLight": "#FFFFFF",
    "text.onColorDark": "#1C3827"
  },
  "skin": {
    "meter": "continuous",
    "meter-intensity": 90,
    "segments": 24,
    "session": {
      "track-width": 88,
      "return-width": 80,
      "scene-width": 84,
      "header-height": 24,
      "slot-height": 22
    },
    "styles": {
      ".pan": {
        "--suhina-appearance": "knob"
      }
    },
    "controls": {
      "mixer-color": {
        "hidden": true
      },
      "mixer-meter": {
        "left": -48
      },
      "mixer-volume": {
        "left": 18
      },
      "mixer-volume-scale": {
        "left": -40
      },
      "mixer-volume-readout": {
        "left": -24,
        "width": 30
      },
      "mixer-pan": {
        "left": 25,
        "width": 24,
        "height": 24
      }
    }
  }
}
