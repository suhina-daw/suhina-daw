{
  "name": "Suhina Sheet",
  "description": "A playful green-and-white Session worksheet with square SVG controls. Audio is calculated in decibels, not cells.",
  "colors": {
    "window.background": "#FFFFFF",
    "panel.background": "#F3F5F3",
    "panel.hoverBackground": "#C6E0B4",
    "control.background": "#FFFFFF",
    "control.hoverBackground": "#D3EBCB",
    "control.activeBackground": "#A9D18E",
